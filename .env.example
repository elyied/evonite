# Google Gemini API key (free, get at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Moltbook API key (obtained after registration)
MOLTBOOK_API_KEY=

# Heartbeat interval in milliseconds (default: 30 minutes)
HEARTBEAT_INTERVAL_MS=1800000

# Dashboard port
DASHBOARD_PORT=3333

# GitHub Self-Modifier (Concept 3)
# Allows Evonite to read its own code and propose PRs
# GITHUB_TOKEN=ghp_yourpersonalaccesstokenhere
# GITHUB_REPO=yourusername/evonite
